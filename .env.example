# ─── LLM PROVIDERS ──────────────────────────────────────────
# Primary provider options: groq | gemini | openai | anthropic
LLM_PROVIDER=gemini

# Groq API Key (from https://console.groq.com/keys)
GROQ_API_KEY=

# Gemini API Key (from https://aistudio.google.com/app/apikeys)
GEMINI_API_KEY=

# OpenAI API Key (optional fallback - from https://platform.openai.com/)
OPENAI_API_KEY=

# Anthropic API Key (optional fallback - from https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# ─── YOUTUBE DATA API ────────────────────────────────────────
# YouTube API Key (from Google Cloud Console, used for search research)
YOUTUBE_API_KEY=

# ─── GOOGLE CUSTOM SEARCH (optional research fallback) ──────
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ─── TEXT-TO-SPEECH (TTS) ────────────────────────────────────
# Options: edge | elevenlabs | openai | playht
TTS_PROVIDER=edge

# ElevenLabs API Key (optional premium TTS - from https://elevenlabs.io/)
ELEVENLABS_API_KEY=

# PlayHT credentials (optional premium TTS - from https://play.ht/)
PLAYHT_USER_ID=
PLAYHT_API_KEY=

# ─── STOCK FOOTAGE ──────────────────────────────────────────
# Pexels API Key (from https://www.pexels.com/api/, used for b-roll clips)
PEXELS_API_KEY=

# Pixabay API Key (optional fallback - from https://pixabay.com/api/docs/)
PIXABAY_API_KEY=

# ─── NOTIFICATIONS (optional) ──────────────────────────────
# CallMeBot WhatsApp notifications
WHATSAPP_PHONE=
WHATSAPP_API_KEY=

# ─── FACEBOOK UPLOAD SETTINGS (optional) ───────────────────
ENABLE_FACEBOOK_UPLOAD=False
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=

# ─── INSTAGRAM UPLOAD SETTINGS (optional) ──────────────────
ENABLE_INSTAGRAM_UPLOAD=False
IG_USER_ID=

# ─── LINKEDIN UPLOAD SETTINGS (optional) ───────────────────
ENABLE_LINKEDIN_UPLOAD=False
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_OWNER_URN=

